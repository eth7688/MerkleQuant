//@version=5
indicator("AXIOM RJ KD V8 主图", shorttitle="RJ KD V8", overlay=true, max_labels_count=300, max_boxes_count=300, max_lines_count=120)

// RJ original check version based on the RSI+KDJ lesson.
// Core additions from this lesson:
// - J = 3K - 2D.
// - RJ uses J as the fast green line and raw RSI as the purple line.
// - Signal families:
//   1) Original J 0/100 key candle: J recovers above 0 or falls back below 100, then wait for key-candle break.
//   2) J/R golden/death cross. In original-combined mode it also creates a key candle.
// - Green/red RJ background is trend context, not Bollinger.
// - A setup candle must be confirmed by a close breaking its high/low box.
// - Stop reference can use setup candle high/low plus ATR.
// - False-signal filters keep the chart focused on higher-quality LONG/SHORT signals.

groupRJ = "RJ核心"
kdjLen = input.int(9, "KDJ RSV长度", minval=1, group=groupRJ)
kSmooth = input.int(3, "K线平滑长度", minval=1, group=groupRJ)
dSmooth = input.int(3, "D线平滑长度", minval=1, group=groupRJ)
rsiLen = input.int(9, "RSI长度", minval=1, group=groupRJ)
rsiSmooth = input.int(1, "RSI平滑长度（原版=1）", minval=1, group=groupRJ)
purpleMode = input.string("K线(贴近原版)", "紫线口径", options=["K线(贴近原版)", "普通RSI", "随机RSI", "J线RSI"], group=groupRJ)
purpleScale = input.float(0.88, "紫线倍率（围绕50）", minval=0.1, maxval=2.0, step=0.01, group=groupRJ)
purpleOffset = input.float(0.0, "紫线偏移", minval=-50.0, maxval=50.0, step=0.1, group=groupRJ)
purpleClamp = input.bool(true, "紫线限制0-100", group=groupRJ)

groupSignal = "信号规则"
setupSource = input.string("原版综合关键K确认", "信号来源", options=["原版综合关键K确认", "原版J线0/100关键K确认", "全部信号", "J/R交叉确认", "J线0/100关键K确认"], group=groupSignal)
jLongLevel = input.float(0.0, "做多线（J上穿）", step=1.0, group=groupSignal)
jShortLevel = input.float(100.0, "做空线（J跌回）", step=1.0, group=groupSignal)
confirmBars = input.int(6, "关键K确认根数", minval=1, maxval=100, group=groupSignal)
engineAlignMode = input.bool(true, "自动交易对齐模式", group=groupSignal)

groupFilter = "假信号过滤"
filterPreset = input.string("自定义", "过滤强度", options=["宽松", "均衡", "严格", "自定义"], group=groupFilter)
directionFilter = input.string("关闭", "方向过滤", options=["RJ+EMA", "仅RJ方向", "关闭"], group=groupFilter)
trendEmaLen = input.int(200, "趋势EMA长度", minval=1, group=groupFilter)
customMinAdx = input.float(0.0, "自定义最低ADX", minval=0.0, step=0.5, group=groupFilter)
customMinJRSpread = input.float(0.0, "自定义J/紫线最小差值", minval=0.0, step=0.5, group=groupFilter)
customConfirmAtrBuffer = input.float(0.08, "自定义确认ATR缓冲", minval=0.0, step=0.01, group=groupFilter)
customCooldownBars = input.int(0, "自定义信号冷却K数", minval=0, maxval=200, group=groupFilter)
adxLen = input.int(14, "ADX长度", minval=1, group=groupFilter)
adxSmooth = input.int(14, "ADX平滑长度", minval=1, group=groupFilter)
useVolumeFilter = input.bool(true, "启用成交量过滤", group=groupFilter)
volLen = input.int(20, "成交量均线长度", minval=1, group=groupFilter)
volMult = input.float(1.1, "成交量倍数", minval=0.0, step=0.1, group=groupFilter)

groupSr = "支撑压力背离过滤"
useSrFilter = input.bool(true, "启用支撑压力过滤", group=groupSr)
srPivotLeft = input.int(5, "支撑压力左侧K数", minval=1, maxval=30, group=groupSr)
srPivotRight = input.int(3, "支撑压力右侧K数", minval=1, maxval=30, group=groupSr)
srNearMode = input.string("ATR或百分比", "贴近判定方式", options=["ATR或百分比", "仅ATR", "仅百分比"], group=groupSr)
srNearAtrMult = input.float(0.8, "贴近ATR倍数", minval=0.0, step=0.1, group=groupSr)
srNearPct = input.float(0.8, "贴近百分比", minval=0.0, step=0.1, group=groupSr)
requireDivergence = input.bool(true, "要求J线背离确认", group=groupSr)
divLookbackBars = input.int(80, "背离有效K数", minval=1, maxval=500, group=groupSr)
useEarlyDivergence = input.bool(true, "允许正在形成的背离", group=groupSr)

groupRisk = "止损参考"
stopMode = input.string("关键K外侧+ATR", "止损模式", options=["关键K", "关键K外侧+ATR"], group=groupRisk)
atrLen = input.int(14, "ATR长度", minval=1, group=groupRisk)
atrMult = input.float(0.5, "ATR倍数", minval=0.0, step=0.1, group=groupRisk)

groupView = "显示设置"
showSetups = input.bool(false, "显示候选小三角", group=groupView)
showOriginalSignals = input.bool(true, "显示原版J0/J100信号三角", group=groupView)
showCrossSignals = input.bool(true, "显示RJ金叉死叉信号三角", group=groupView)
showBoxes = input.bool(true, "显示确认关键K盒子（主图版）", group=groupView)
showInvalid = input.bool(false, "显示失效标记", group=groupView)
showOriginalCompare = input.bool(true, "显示原版J0/J100对比小三角", group=groupView)
showBg = input.bool(true, "显示RJ背景", group=groupView)
colorBars = input.bool(false, "K线着色", group=groupView)
showTrendEma = input.bool(false, "显示趋势EMA", group=groupView)
showSrLines = input.bool(true, "显示支撑压力线", group=groupView)
showDivergenceMarks = input.bool(true, "显示背离标记", group=groupView)
showTable = input.bool(true, "显示状态表", group=groupView)
drawMainChartBoxes = true

// RJ fast line: KDJ J. KD V8 uses the regular stochastic K/D smoothing style.
ll = ta.lowest(low, kdjLen)
hh = ta.highest(high, kdjLen)
den = hh - ll
rsv = na(ll) or na(hh) or den == 0.0 ? 50.0 : (close - ll) / den * 100.0
kLine = ta.sma(rsv, kSmooth)
dLine = ta.sma(kLine, dSmooth)
jLine = 3.0 * kLine - 2.0 * dLine

// Purple line candidates. The original KD V8 purple value behaves closest to the K line
// on the supplied GRAMUSDT comparison, while RSI modes remain available for checking.
rsiRaw = ta.rsi(close, rsiLen)
rsiLine = rsiSmooth <= 1 ? (na(rsiRaw) ? 50.0 : rsiRaw) : ta.ema(na(rsiRaw) ? 50.0 : rsiRaw, rsiSmooth)
rsiLow = ta.lowest(rsiLine, rsiLen)
rsiHigh = ta.highest(rsiLine, rsiLen)
rsiDen = rsiHigh - rsiLow
stochRsiLine = na(rsiLow) or na(rsiHigh) or rsiDen == 0.0 ? 50.0 : (rsiLine - rsiLow) / rsiDen * 100.0
jRsiRaw = ta.rsi(jLine, rsiLen)
jRsiLine = rsiSmooth <= 1 ? (na(jRsiRaw) ? 50.0 : jRsiRaw) : ta.ema(na(jRsiRaw) ? 50.0 : jRsiRaw, rsiSmooth)
rLineBase = purpleMode == "K线(贴近原版)" ? kLine : purpleMode == "随机RSI" ? stochRsiLine : purpleMode == "J线RSI" ? jRsiLine : rsiLine
rLineAdjusted = 50.0 + (rLineBase - 50.0) * purpleScale + purpleOffset
rLine = purpleClamp ? math.max(0.0, math.min(100.0, rLineAdjusted)) : rLineAdjusted

// RJ background: green when fast line dominates, red when slow/bear side dominates.
rjBull = jLine >= rLine
rjBear = jLine < rLine
bgcolor(showBg ? (rjBull ? color.new(color.green, 90) : color.new(color.red, 90)) : na, title="RJ背景")

// Main-chart mode: RJ oscillator values are kept in Data Window/status table.

barCloseOkSignal = barstate.isconfirmed

// Signal families from the lesson.
useOriginalKey = setupSource == "原版综合关键K确认" or setupSource == "原版J线0/100关键K确认"
useCross = setupSource == "原版综合关键K确认" or setupSource == "全部信号" or setupSource == "J/R交叉确认"
useLevel = setupSource == "原版综合关键K确认" or setupSource == "原版J线0/100关键K确认" or setupSource == "全部信号" or setupSource == "J线0/100关键K确认"
crossLongRaw = ta.crossover(jLine, rLine)
crossShortRaw = ta.crossunder(jLine, rLine)
crossLong = barCloseOkSignal and crossLongRaw
crossShort = barCloseOkSignal and crossShortRaw
var bool jOversoldArmed = false
var bool jOverboughtArmed = false
originalLongSignal = false
originalShortSignal = false
if barCloseOkSignal
    if jLine < jLongLevel
        jOversoldArmed := true
    if jLine > jShortLevel
        jOverboughtArmed := true
    originalLongSignal := jOversoldArmed and jLine >= jLongLevel
    originalShortSignal := jOverboughtArmed and jLine <= jShortLevel
    if originalLongSignal
        jOversoldArmed := false
    if originalShortSignal
        jOverboughtArmed := false
levelLong = originalLongSignal
levelShort = originalShortSignal
longLevelSetupRaw = useLevel and originalLongSignal
shortLevelSetupRaw = useLevel and originalShortSignal
longCrossSetupRaw = useCross and crossLong
shortCrossSetupRaw = useCross and crossShort
rawLongSetup = longLevelSetupRaw or longCrossSetupRaw
rawShortSetup = shortLevelSetupRaw or shortCrossSetupRaw

// Practical false-signal filters.
trendEma = ta.ema(close, trendEmaLen)
[plusDi, minusDi, adxLine] = ta.dmi(adxLen, adxSmooth)
volMa = ta.sma(volume, volLen)[1]

minAdx = filterPreset == "宽松" ? 0.0 : filterPreset == "均衡" ? 18.0 : filterPreset == "严格" ? 22.0 : customMinAdx
minJRSpread = filterPreset == "宽松" ? 0.0 : filterPreset == "均衡" ? 2.0 : filterPreset == "严格" ? 4.0 : customMinJRSpread
confirmAtrBuffer = filterPreset == "宽松" ? 0.0 : filterPreset == "均衡" ? 0.08 : filterPreset == "严格" ? 0.16 : customConfirmAtrBuffer
confirmAtrBufferActive = useOriginalKey ? 0.0 : confirmAtrBuffer
cooldownBars = filterPreset == "宽松" ? 0 : filterPreset == "均衡" ? 12 : filterPreset == "严格" ? 24 : customCooldownBars

longDirectionOk = directionFilter == "关闭" or (directionFilter == "仅RJ方向" and rjBull) or (directionFilter == "RJ+EMA" and rjBull and close >= trendEma)
shortDirectionOk = directionFilter == "关闭" or (directionFilter == "仅RJ方向" and rjBear) or (directionFilter == "RJ+EMA" and rjBear and close <= trendEma)
adxOk = minAdx <= 0.0 or adxLine >= minAdx
volumeRatio = not na(volMa) and volMa > 0.0 ? volume / volMa : na
volumeOk = not useVolumeFilter or (not na(volumeRatio) and volumeRatio >= volMult)
longSpreadOk = minJRSpread <= 0.0 or jLine - rLine >= minJRSpread
shortSpreadOk = minJRSpread <= 0.0 or rLine - jLine >= minJRSpread

// Support/resistance plus J-line divergence filter.
pricePivotLow = ta.pivotlow(low, srPivotLeft, srPivotRight)
pricePivotHigh = ta.pivothigh(high, srPivotLeft, srPivotRight)
pivotLowFound = not na(pricePivotLow)
pivotHighFound = not na(pricePivotHigh)
pivotLowBar = bar_index - srPivotRight
pivotHighBar = bar_index - srPivotRight
pivotLowJ = jLine[srPivotRight]
pivotHighJ = jLine[srPivotRight]

var float lastSupport = na
var float lastResistance = na
var int lastSupportBar = na
var int lastResistanceBar = na
var float prevPivotLowPrice = na
var float prevPivotLowJ = na
var float prevPivotHighPrice = na
var float prevPivotHighJ = na
var int lastBullDivBar = na
var int lastBearDivBar = na

earlyBullDiv = useEarlyDivergence and not na(prevPivotLowPrice) and not na(prevPivotLowJ) and low < prevPivotLowPrice and jLine > prevPivotLowJ
earlyBearDiv = useEarlyDivergence and not na(prevPivotHighPrice) and not na(prevPivotHighJ) and high > prevPivotHighPrice and jLine < prevPivotHighJ
bullDivSignal = false
bearDivSignal = false

if pivotLowFound
    bullDivSignal := not na(prevPivotLowPrice) and not na(prevPivotLowJ) and pricePivotLow < prevPivotLowPrice and pivotLowJ > prevPivotLowJ
    lastSupport := pricePivotLow
    lastSupportBar := pivotLowBar
    if bullDivSignal
        lastBullDivBar := pivotLowBar
    prevPivotLowPrice := pricePivotLow
    prevPivotLowJ := pivotLowJ

if pivotHighFound
    bearDivSignal := not na(prevPivotHighPrice) and not na(prevPivotHighJ) and pricePivotHigh > prevPivotHighPrice and pivotHighJ < prevPivotHighJ
    lastResistance := pricePivotHigh
    lastResistanceBar := pivotHighBar
    if bearDivSignal
        lastBearDivBar := pivotHighBar
    prevPivotHighPrice := pricePivotHigh
    prevPivotHighJ := pivotHighJ

srAtr = ta.atr(atrLen)
supportDistPct = not na(lastSupport) and close != 0.0 ? math.abs(low - lastSupport) / close * 100.0 : na
resistanceDistPct = not na(lastResistance) and close != 0.0 ? math.abs(high - lastResistance) / close * 100.0 : na
supportNearAtrOk = not na(lastSupport) and not na(srAtr) and math.abs(low - lastSupport) <= srAtr * srNearAtrMult
resistanceNearAtrOk = not na(lastResistance) and not na(srAtr) and math.abs(high - lastResistance) <= srAtr * srNearAtrMult
supportNearPctOk = not na(supportDistPct) and supportDistPct <= srNearPct
resistanceNearPctOk = not na(resistanceDistPct) and resistanceDistPct <= srNearPct
longNearSupport = not useSrFilter or (srNearMode == "仅ATR" ? supportNearAtrOk : srNearMode == "仅百分比" ? supportNearPctOk : (supportNearAtrOk or supportNearPctOk))
shortNearResistance = not useSrFilter or (srNearMode == "仅ATR" ? resistanceNearAtrOk : srNearMode == "仅百分比" ? resistanceNearPctOk : (resistanceNearAtrOk or resistanceNearPctOk))
bullDivRecent = not na(lastBullDivBar) and bar_index - lastBullDivBar <= divLookbackBars
bearDivRecent = not na(lastBearDivBar) and bar_index - lastBearDivBar <= divLookbackBars
bullDivActive = bullDivRecent or earlyBullDiv
bearDivActive = bearDivRecent or earlyBearDiv
longDivOk = not useSrFilter or not requireDivergence or bullDivActive
shortDivOk = not useSrFilter or not requireDivergence or bearDivActive
longSrOk = not useSrFilter or (longNearSupport and longDivOk)
shortSrOk = not useSrFilter or (shortNearResistance and shortDivOk)

// Pending confirmation boxes.
var float longBoxHi = na
var float longBoxLo = na
var float longBoxStop = na
var int longBoxBar = na
var bool longBoxIsLevel = false
var bool longBoxFilterOk = false
var float longBoxVolumeRatio = na
var float shortBoxHi = na
var float shortBoxLo = na
var float shortBoxStop = na
var int shortBoxBar = na
var bool shortBoxIsLevel = false
var bool shortBoxFilterOk = false
var float shortBoxVolumeRatio = na

// Direction state: 1 long, -1 short, 0 flat.
var int tradeDir = 0
var float entryPrice = na
var float stopPrice = na
var int lastSignalBar = na
atrValue = ta.atr(atrLen)
barCloseOk = barstate.isconfirmed
cooldownOk = cooldownBars <= 0 or na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
noPendingBox = na(longBoxBar) and na(shortBoxBar)
longSetupSpreadOk = longLevelSetupRaw or longSpreadOk
shortSetupSpreadOk = shortLevelSetupRaw or shortSpreadOk
longVisualFilterOk = longSrOk and longDirectionOk and adxOk and volumeOk and cooldownOk
shortVisualFilterOk = shortSrOk and shortDirectionOk and adxOk and volumeOk and cooldownOk
setupFilterOk = longVisualFilterOk and longSetupSpreadOk and noPendingBox
shortSetupFilterOk = shortVisualFilterOk and shortSetupSpreadOk and noPendingBox
longSetup = barCloseOk and rawLongSetup and setupFilterOk
shortSetup = barCloseOk and rawShortSetup and shortSetupFilterOk

longSignal = false
shortSignal = false
longInvalid = false
shortInvalid = false
longExpired = false
shortExpired = false

if longSetup
    longBoxHi := high
    longBoxLo := low
    longBoxStop := stopMode == "关键K外侧+ATR" ? low - atrValue * atrMult : low
    longBoxBar := bar_index
    longBoxIsLevel := longLevelSetupRaw
    longBoxFilterOk := setupFilterOk
    longBoxVolumeRatio := volumeRatio
    shortBoxHi := na
    shortBoxLo := na
    shortBoxStop := na
    shortBoxBar := na
    shortBoxIsLevel := false
    shortBoxFilterOk := false
    shortBoxVolumeRatio := na
    if showBoxes and drawMainChartBoxes
        box.new(left=bar_index, top=high, right=bar_index + confirmBars, bottom=low, border_color=color.new(color.lime, 35), bgcolor=color.new(color.lime, 91))

if shortSetup
    shortBoxHi := high
    shortBoxLo := low
    shortBoxStop := stopMode == "关键K外侧+ATR" ? high + atrValue * atrMult : high
    shortBoxBar := bar_index
    shortBoxIsLevel := shortLevelSetupRaw
    shortBoxFilterOk := shortSetupFilterOk
    shortBoxVolumeRatio := volumeRatio
    longBoxHi := na
    longBoxLo := na
    longBoxStop := na
    longBoxBar := na
    longBoxIsLevel := false
    longBoxFilterOk := false
    longBoxVolumeRatio := na
    if showBoxes and drawMainChartBoxes
        box.new(left=bar_index, top=high, right=bar_index + confirmBars, bottom=low, border_color=color.new(color.red, 35), bgcolor=color.new(color.red, 91))

if not na(longBoxBar) and bar_index > longBoxBar
    longAge = bar_index - longBoxBar
    longConfirmBreak = barCloseOk and close > longBoxHi + atrValue * confirmAtrBufferActive
    longConfirmOk = barCloseOk and longBoxFilterOk and cooldownOk
    if barCloseOk and close < longBoxLo
        longInvalid := true
        longBoxHi := na
        longBoxLo := na
        longBoxStop := na
        longBoxBar := na
        longBoxIsLevel := false
        longBoxFilterOk := false
        longBoxVolumeRatio := na
    else if longConfirmBreak and longConfirmOk
        longSignal := true
        tradeDir := 1
        entryPrice := close
        stopPrice := longBoxStop
        lastSignalBar := bar_index
        longBoxHi := na
        longBoxLo := na
        longBoxStop := na
        longBoxBar := na
        longBoxIsLevel := false
        longBoxFilterOk := false
        longBoxVolumeRatio := na
        shortBoxHi := na
        shortBoxLo := na
        shortBoxStop := na
        shortBoxBar := na
        shortBoxIsLevel := false
        shortBoxFilterOk := false
        shortBoxVolumeRatio := na
    else if barCloseOk and longAge > confirmBars
        longExpired := true
        longBoxHi := na
        longBoxLo := na
        longBoxStop := na
        longBoxBar := na
        longBoxIsLevel := false
        longBoxFilterOk := false
        longBoxVolumeRatio := na

if not na(shortBoxBar) and bar_index > shortBoxBar
    shortAge = bar_index - shortBoxBar
    shortConfirmBreak = barCloseOk and close < shortBoxLo - atrValue * confirmAtrBufferActive
    shortConfirmOk = barCloseOk and shortBoxFilterOk and cooldownOk
    if barCloseOk and close > shortBoxHi
        shortInvalid := true
        shortBoxHi := na
        shortBoxLo := na
        shortBoxStop := na
        shortBoxBar := na
        shortBoxIsLevel := false
        shortBoxFilterOk := false
        shortBoxVolumeRatio := na
    else if shortConfirmBreak and shortConfirmOk
        shortSignal := true
        tradeDir := -1
        entryPrice := close
        stopPrice := shortBoxStop
        lastSignalBar := bar_index
        shortBoxHi := na
        shortBoxLo := na
        shortBoxStop := na
        shortBoxBar := na
        shortBoxIsLevel := false
        shortBoxFilterOk := false
        shortBoxVolumeRatio := na
        longBoxHi := na
        longBoxLo := na
        longBoxStop := na
        longBoxBar := na
        longBoxIsLevel := false
        longBoxFilterOk := false
        longBoxVolumeRatio := na
    else if barCloseOk and shortAge > confirmBars
        shortExpired := true
        shortBoxHi := na
        shortBoxLo := na
        shortBoxStop := na
        shortBoxBar := na
        shortBoxIsLevel := false
        shortBoxFilterOk := false
        shortBoxVolumeRatio := na

// Automatic-trading alignment: scan the last N closed bars for a J/R cross key candle,
// then confirm on the current close, matching the backend RJ-only entry detector.
engineLongSignal = false
engineShortSignal = false
float engineLongStop = na
float engineShortStop = na
engineLongSpreadOk = minJRSpread <= 0.0 or jLine - rLine >= minJRSpread
engineShortSpreadOk = minJRSpread <= 0.0 or rLine - jLine >= minJRSpread
if engineAlignMode and barCloseOk
    for i = 1 to confirmBars
        engineLongTrigger = crossLongRaw[i] or originalLongSignal[i]
        engineLongSpreadOkKey = minJRSpread <= 0.0 or jLine[i] - rLine[i] >= minJRSpread
        engineLongTriggerOk = originalLongSignal[i] or engineLongSpreadOkKey
        engineLongDirectionOkKey = directionFilter == "关闭" or (directionFilter == "仅RJ方向" and rjBull[i]) or (directionFilter == "RJ+EMA" and rjBull[i] and close[i] >= trendEma[i])
        engineLongAdxOkKey = minAdx <= 0.0 or adxLine[i] >= minAdx
        engineLongVolumeRatioKey = volumeRatio[i]
        engineLongVolumeOkKey = not useVolumeFilter or (not na(engineLongVolumeRatioKey) and engineLongVolumeRatioKey >= volMult)
        engineLongFilterOk = engineLongDirectionOkKey and engineLongAdxOkKey and engineLongVolumeOkKey and cooldownOk
        if not engineLongSignal and engineLongTriggerOk and engineLongTrigger and engineLongFilterOk and not na(high[i]) and not na(low[i]) and longSrOk[i]
            keyHigh = high[i]
            keyLow = low[i]
            confirmLevel = keyHigh + atrValue * confirmAtrBuffer
            invalidated = false
            alreadyConfirmed = false
            if i > 1
                for j = 1 to i - 1
                    invalidated := invalidated or close[j] < keyLow
                    alreadyConfirmed := alreadyConfirmed or close[j] > confirmLevel
            if not invalidated and not alreadyConfirmed and close > confirmLevel
                engineLongSignal := true
                engineLongStop := stopMode == "关键K外侧+ATR" ? keyLow - atrValue * atrMult : keyLow
        engineShortTrigger = crossShortRaw[i] or originalShortSignal[i]
        engineShortSpreadOkKey = minJRSpread <= 0.0 or rLine[i] - jLine[i] >= minJRSpread
        engineShortTriggerOk = originalShortSignal[i] or engineShortSpreadOkKey
        engineShortDirectionOkKey = directionFilter == "关闭" or (directionFilter == "仅RJ方向" and rjBear[i]) or (directionFilter == "RJ+EMA" and rjBear[i] and close[i] <= trendEma[i])
        engineShortAdxOkKey = minAdx <= 0.0 or adxLine[i] >= minAdx
        engineShortVolumeRatioKey = volumeRatio[i]
        engineShortVolumeOkKey = not useVolumeFilter or (not na(engineShortVolumeRatioKey) and engineShortVolumeRatioKey >= volMult)
        engineShortFilterOk = engineShortDirectionOkKey and engineShortAdxOkKey and engineShortVolumeOkKey and cooldownOk
        if not engineShortSignal and engineShortTriggerOk and engineShortTrigger and engineShortFilterOk and not na(high[i]) and not na(low[i]) and shortSrOk[i]
            keyHigh = high[i]
            keyLow = low[i]
            confirmLevel = keyLow - atrValue * confirmAtrBuffer
            invalidated = false
            alreadyConfirmed = false
            if i > 1
                for j = 1 to i - 1
                    invalidated := invalidated or close[j] > keyHigh
                    alreadyConfirmed := alreadyConfirmed or close[j] < confirmLevel
            if not invalidated and not alreadyConfirmed and close < confirmLevel
                engineShortSignal := true
                engineShortStop := stopMode == "关键K外侧+ATR" ? keyHigh + atrValue * atrMult : keyHigh

if engineAlignMode
    longSignal := engineLongSignal
    shortSignal := engineShortSignal
    if engineLongSignal
        tradeDir := 1
        entryPrice := close
        stopPrice := engineLongStop
        lastSignalBar := bar_index
    if engineShortSignal
        tradeDir := -1
        entryPrice := close
        stopPrice := engineShortStop
        lastSignalBar := bar_index

longRisk = tradeDir == 1 and not na(entryPrice) and not na(stopPrice) and entryPrice > stopPrice ? entryPrice - stopPrice : na
shortRisk = tradeDir == -1 and not na(entryPrice) and not na(stopPrice) and stopPrice > entryPrice ? stopPrice - entryPrice : na
rMultiple = tradeDir == 1 and not na(longRisk) ? (close - entryPrice) / longRisk : tradeDir == -1 and not na(shortRisk) ? (entryPrice - close) / shortRisk : na
activeSignalVolumeRatio = not na(longBoxBar) ? longBoxVolumeRatio : not na(shortBoxBar) ? shortBoxVolumeRatio : volumeRatio
activeSignalVolumeOk = not useVolumeFilter or (not na(activeSignalVolumeRatio) and activeSignalVolumeRatio >= volMult)

// Main-chart price diagnostics.
plot(showBoxes and not na(longBoxBar) ? longBoxHi : na, "做多关键K高点", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=1)
plot(showBoxes and not na(longBoxBar) ? longBoxLo : na, "做多关键K低点", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=1)
plot(showBoxes and not na(shortBoxBar) ? shortBoxHi : na, "做空关键K高点", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(showBoxes and not na(shortBoxBar) ? shortBoxLo : na, "做空关键K低点", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(tradeDir != 0 ? stopPrice : na, "RJ当前止损", color=color.new(color.orange, 0), style=plot.style_linebr, linewidth=1)
plot(showTrendEma and directionFilter == "RJ+EMA" ? trendEma : na, "RJ趋势EMA", color=color.new(color.white, 35), linewidth=1)
plot(showSrLines and useSrFilter ? lastSupport : na, "RJ支撑位", color=color.new(color.lime, 25), style=plot.style_linebr, linewidth=1)
plot(showSrLines and useSrFilter ? lastResistance : na, "RJ压力位", color=color.new(color.red, 25), style=plot.style_linebr, linewidth=1)

candleColor = longSignal ? color.lime : shortSignal ? color.red : rjBull ? color.new(color.green, 20) : color.new(color.red, 20)
barcolor(colorBars ? candleColor : na)

// Clean chart: only confirmed labels show 多/空.
plotOriginalTriangles = showOriginalSignals or (showOriginalCompare and not useOriginalKey)
plotOriginalLong = plotOriginalTriangles and originalLongSignal and longVisualFilterOk
plotOriginalShort = plotOriginalTriangles and originalShortSignal and shortVisualFilterOk
plotCrossLong = showCrossSignals and crossLong and not originalLongSignal and longVisualFilterOk and longSpreadOk
plotCrossShort = showCrossSignals and crossShort and not originalShortSignal and shortVisualFilterOk and shortSpreadOk
plotshape(plotOriginalLong, title="原版J0做多信号", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(plotOriginalShort, title="原版J100做空信号", style=shape.triangledown, location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.tiny)
plotshape(plotCrossLong, title="RJ金叉做多信号", style=shape.triangleup, location=location.belowbar, color=color.new(color.blue, 0), size=size.tiny)
plotshape(plotCrossShort, title="RJ死叉做空信号", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.tiny)
plotshape(showDivergenceMarks and bullDivSignal, title="RJ底背离", style=shape.circle, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny, offset=-srPivotRight)
plotshape(showDivergenceMarks and bearDivSignal, title="RJ顶背离", style=shape.circle, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, offset=-srPivotRight)
plotshape(showSetups and longSetup, title="RJ做多候选", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.tiny)
plotshape(showSetups and shortSetup, title="RJ做空候选", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)
plotshape(longSignal, title="RJ确认多", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.black, size=size.small, text="多")
plotshape(shortSignal, title="RJ确认空", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small, text="空")
plotshape(showInvalid and longInvalid, title="RJ做多失效", style=shape.xcross, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny)
plotshape(showInvalid and shortInvalid, title="RJ做空失效", style=shape.xcross, location=location.abovebar, color=color.new(color.lime, 0), size=size.tiny)

// Hidden oscillator values for Data Window and alert inspection.
plot(jLine, "RJ J绿线", color=color.green, display=display.data_window)
plot(rLine, "RJ 紫线", color=color.purple, display=display.data_window)
plot(rLineBase, "紫线原始值", color=color.new(color.purple, 40), display=display.data_window)
plot(rsiLine, "普通RSI参考", color=color.gray, display=display.data_window)
plot(kLine, "K线参考", color=color.teal, display=display.data_window)
plot(originalLongSignal ? 1 : 0, "原版J0做多触发", color=color.lime, display=display.data_window)
plot(originalShortSignal ? 1 : 0, "原版J100做空触发", color=color.red, display=display.data_window)
plot(crossLong ? 1 : 0, "RJ金叉触发", color=color.aqua, display=display.data_window)
plot(crossShort ? 1 : 0, "RJ死叉触发", color=color.orange, display=display.data_window)
plot(lastSupport, "RJ最近支撑位", color=color.lime, display=display.data_window)
plot(lastResistance, "RJ最近压力位", color=color.red, display=display.data_window)
plot(supportDistPct, "距离支撑百分比", color=color.lime, display=display.data_window)
plot(resistanceDistPct, "距离压力百分比", color=color.red, display=display.data_window)
plot(longNearSupport ? 1 : 0, "贴近支撑允许多", color=color.lime, display=display.data_window)
plot(shortNearResistance ? 1 : 0, "贴近压力允许空", color=color.red, display=display.data_window)
plot(bullDivActive ? 1 : 0, "底背离有效", color=color.lime, display=display.data_window)
plot(bearDivActive ? 1 : 0, "顶背离有效", color=color.red, display=display.data_window)
plot(longDirectionOk ? 1 : 0, "方向过滤允许多", color=color.lime, display=display.data_window)
plot(shortDirectionOk ? 1 : 0, "方向过滤允许空", color=color.red, display=display.data_window)
plot(adxOk ? 1 : 0, "ADX过滤通过", color=color.white, display=display.data_window)
plot(activeSignalVolumeOk ? 1 : 0, "信号K成交量过滤通过", color=color.orange, display=display.data_window)
plot(activeSignalVolumeRatio, "信号K成交量/均量倍数", color=color.orange, display=display.data_window)
plot(longSpreadOk ? 1 : 0, "J/紫线差值允许多", color=color.aqua, display=display.data_window)
plot(shortSpreadOk ? 1 : 0, "J/紫线差值允许空", color=color.orange, display=display.data_window)
plot(cooldownOk ? 1 : 0, "冷却过滤通过", color=color.gray, display=display.data_window)
plot(longVisualFilterOk ? 1 : 0, "做多基础过滤通过", color=color.lime, display=display.data_window)
plot(shortVisualFilterOk ? 1 : 0, "做空基础过滤通过", color=color.red, display=display.data_window)

// Compact state table.
var table statusTable = table.new(position.top_right, 2, 12, border_width=1)
if showTable and barstate.islast
    bgTxt = rjBull ? "绿色/偏多" : "红色/偏空"
    dirTxt = tradeDir == 1 ? "多" : tradeDir == -1 ? "空" : "空仓"
    waitTxt = not na(longBoxBar) ? "等待多" : not na(shortBoxBar) ? "等待空" : "-"
    table.cell(statusTable, 0, 0, "RJ背景", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 1, 0, bgTxt, text_color=rjBull ? color.lime : color.red, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 1, "J / 紫线", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 1, 1, str.tostring(jLine, "#.##") + " / " + str.tostring(rLine, "#.##"), text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 2, "紫线口径", text_color=color.white, bgcolor=color.new(color.black, 15))
    purpleCfgTxt = purpleMode + " x" + str.tostring(purpleScale, "#.##") + " " + (purpleOffset >= 0 ? "+" : "") + str.tostring(purpleOffset, "#.#")
    table.cell(statusTable, 1, 2, purpleCfgTxt, text_color=color.purple, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 3, "状态", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 1, 3, dirTxt, text_color=tradeDir == 1 ? color.lime : tradeDir == -1 ? color.red : color.gray, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 4, "R", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 1, 4, na(rMultiple) ? "--" : str.tostring(rMultiple, "#.##"), text_color=not na(rMultiple) and rMultiple >= 1 ? color.orange : color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 5, "流程", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 1, 5, waitTxt, text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 6, "信号源", text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 1, 6, setupSource, text_color=color.white, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 7, "过滤", text_color=color.white, bgcolor=color.new(color.black, 15))
    filterTxt = "多:" + (longVisualFilterOk ? "过" : "挡") + " 空:" + (shortVisualFilterOk ? "过" : "挡")
    table.cell(statusTable, 1, 7, filterTxt, text_color=(longVisualFilterOk or shortVisualFilterOk) ? color.white : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 8, "方向/ADX", text_color=color.white, bgcolor=color.new(color.black, 15))
    dirAdxTxt = "多:" + (longDirectionOk ? "OK" : "X") + " 空:" + (shortDirectionOk ? "OK" : "X") + " ADX:" + str.tostring(adxLine, "#.##") + "/" + str.tostring(minAdx, "#.##")
    table.cell(statusTable, 1, 8, dirAdxTxt, text_color=(adxOk and (longDirectionOk or shortDirectionOk)) ? color.white : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 9, "成交量", text_color=color.white, bgcolor=color.new(color.black, 15))
    volTxt = not useVolumeFilter ? "关闭" : na(activeSignalVolumeRatio) ? "信号K均量不足" : str.tostring(activeSignalVolumeRatio, "#.##") + "x / " + str.tostring(volMult, "#.##") + "x"
    table.cell(statusTable, 1, 9, volTxt, text_color=not useVolumeFilter ? color.gray : activeSignalVolumeOk ? color.lime : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 10, "差值/冷却", text_color=color.white, bgcolor=color.new(color.black, 15))
    spreadTxt = "多:" + (longSpreadOk ? "OK" : "低") + " 空:" + (shortSpreadOk ? "OK" : "低") + " / " + (cooldownOk ? "冷却OK" : "冷却中")
    table.cell(statusTable, 1, 10, spreadTxt, text_color=(cooldownOk and (longSpreadOk or shortSpreadOk)) ? color.white : color.orange, bgcolor=color.new(color.black, 15))
    table.cell(statusTable, 0, 11, "支压背离", text_color=color.white, bgcolor=color.new(color.black, 15))
    srLongTxt = longNearSupport ? "近支撑" : "离支撑"
    srShortTxt = shortNearResistance ? "近压力" : "离压力"
    divLongTxt = not requireDivergence ? "背离关" : bullDivActive ? "底背离" : "无底背"
    divShortTxt = not requireDivergence ? "背离关" : bearDivActive ? "顶背离" : "无顶背"
    srTxt = useSrFilter ? "多:" + srLongTxt + "/" + divLongTxt + " 空:" + srShortTxt + "/" + divShortTxt : "关闭"
    srColor = longSrOk ? color.lime : shortSrOk ? color.red : color.orange
    table.cell(statusTable, 1, 11, srTxt, text_color=useSrFilter ? srColor : color.gray, bgcolor=color.new(color.black, 15))

if not showTable and barstate.islast
    table.clear(statusTable, 0, 0, 1, 11)

// Alerts focused on confirmed long/short.
alertcondition(longSetup, title="RJ做多候选", message="RJ做多候选：{{ticker}} {{interval}}，支撑位/底背离过滤通过，等待收盘突破关键K高点。")
alertcondition(longSignal, title="RJ确认多", message="RJ确认多：{{ticker}} {{interval}}。")
alertcondition(shortSetup, title="RJ做空候选", message="RJ做空候选：{{ticker}} {{interval}}，压力位/顶背离过滤通过，等待收盘跌破关键K低点。")
alertcondition(shortSignal, title="RJ确认空", message="RJ确认空：{{ticker}} {{interval}}。")
alertcondition(longInvalid, title="RJ做多失效", message="RJ做多候选失效：{{ticker}} {{interval}}。")
alertcondition(shortInvalid, title="RJ做空失效", message="RJ做空候选失效：{{ticker}} {{interval}}。")
